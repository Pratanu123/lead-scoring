{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "lead-scoring MVP",
    "description": "Authenticated lead create, status update, async score job, and score history.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{apiKey}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "apiKey", "value": "dev-lead-scoring-key" },
    { "key": "leadId", "value": "" },
    { "key": "jobId", "value": "" },
    { "key": "idempotencyKey", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "API Health",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/healthz"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('healthy', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Metrics",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/metrics"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('metrics ok', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Leads and Scoring",
      "item": [
        {
          "name": "Create Lead",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const suffix = Date.now().toString();",
                  "pm.collectionVariables.set('idempotencyKey', 'mvp-' + suffix);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('created', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('leadId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"company_name\": \"Postman Logistics\",\n  \"contact_name\": \"Alex\",\n  \"email\": \"alex-{{idempotencyKey}}@example.com\",\n  \"source\": \"webinar\",\n  \"industry\": \"logistics\",\n  \"company_size\": 400,\n  \"annual_revenue\": 8000000,\n  \"notes\": \"Evaluating automation\"\n}"
            },
            "url": "{{baseUrl}}/v1/leads"
          }
        },
        {
          "name": "Patch Status",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status updated', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().status).to.eql('qualified');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"qualified\"\n}"
            },
            "url": "{{baseUrl}}/v1/leads/{{leadId}}"
          }
        },
        {
          "name": "Enqueue Score",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('accepted', function () { pm.response.to.have.status(202); });",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('jobId', body.job_id);",
                  "pm.test('job id present', function () { pm.expect(body.job_id).to.be.ok; });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/v1/leads/{{leadId}}/score"
          }
        },
        {
          "name": "Get Job",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('job fetched', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/v1/jobs/{{jobId}}"
          }
        },
        {
          "name": "Latest Score",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": ["setTimeout(() => {}, 1500);"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/v1/leads/{{leadId}}/score"
          }
        },
        {
          "name": "Score History",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/v1/leads/{{leadId}}/scores?limit=20"
          }
        }
      ]
    }
  ]
}
